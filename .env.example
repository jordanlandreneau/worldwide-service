# The Service site's own Supabase project (not 4.0's).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# HR hub access check (@worldwidebdc.com staff not listed in app_users).
HR_SUPABASE_URL=
HR_SUPABASE_ANON_KEY=
HR_ACCESS_SECRET=

# Optional comma separated emails that stay admin even if the HR hub is down.
BOOTSTRAP_ADMIN_EMAILS=

# Password resets.
RESEND_API_KEY=
INVITE_EMAIL_FROM=
